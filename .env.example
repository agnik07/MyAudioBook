# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:3001

# Cloudflare R2 Storage Credentials (STRICTLY SERVER-SIDE - NEVER EXPOSE TO BROWSER)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=myaudiobook-storage
CLOUDFLARE_R2_PUBLIC_URL=

# Groq Speech-to-Text & LLM API Key (STRICTLY SERVER-SIDE)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Backend Server Port
PORT=3001

